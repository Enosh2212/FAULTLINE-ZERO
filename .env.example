# Local demo values; do not expose the development stack to the internet.
FZ_GRAPH_HOST=graph
FZ_GRAPH_PORT=6379
FZ_GRAPH_NAME=faultline_zero
FZ_GRAPH_PASSWORD=
FZ_API_KEY=
FZ_AUTO_SEED=true
FZ_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional Git tool-calling provider (legacy endpoint uses priority ordering); disabled without all three fields.
# Never send confidential graph data to a third-party provider without approval.
FZ_LLM_API_KEY=your_optional_llm_api_key_here
FZ_LLM_BASE_URL=https://api.groq.com/openai/v1
FZ_LLM_MODEL=openai/gpt-oss-120b

# Browser authentication UI (/login and /register). Public Firebase web configuration only.
# Install the optional server verifier with FZ_PYTHON_EXTRAS=auth when building Docker.
FZ_PYTHON_EXTRAS=
# Firebase Admin server credentials (keep private JSON outside the repository)
# Point either GOOGLE_APPLICATION_CREDENTIALS or FZ_FIREBASE_CREDENTIALS_PATH to your service account JSON
GOOGLE_APPLICATION_CREDENTIALS=
FZ_FIREBASE_CREDENTIALS_PATH=
FZ_FIREBASE_WEB_API_KEY=
FZ_FIREBASE_AUTH_DOMAIN=
FZ_FIREBASE_WEB_APP_ID=
FZ_FIREBASE_GITHUB_ENABLED=true
FZ_FIREBASE_GOOGLE_ENABLED=true
# Keep the local sample in demo mode until real Firebase/server configuration is supplied.
FZ_AUTH_MOCK_ENABLED=false
FZ_SESSION_COOKIE_SECURE=false

# GitHub App Integration (Keep private .pem key outside this repository)
FZ_GITHUB_APP_ID=
FZ_GITHUB_APP_PRIVATE_KEY_PATH=
FZ_GITHUB_APP_PRIVATE_KEY_FILE=
FZ_GITHUB_WEBHOOK_SECRET=

